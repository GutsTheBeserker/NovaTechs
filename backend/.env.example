# Environment Configuration for Adaptive Phishing Detection Backend
# Safe default values for local development

FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
SECRET_KEY=adaptive-phishing-default-safe-secret-key-32chars
MODEL_PATH=app/ml/models/phishing_model.joblib
METADATA_PATH=app/ml/models/model_metadata.json
CORS_ALLOWED_ORIGINS=chrome-extension://*,http://127.0.0.1:*,http://localhost:*
LOG_LEVEL=INFO
