{
  "manifest_version": 3,
  "name": "PhishGuard: Adaptive Phishing Detection",
  "version": "0.1.0",
  "description": "Real-time, explainable, privacy-conscious phishing detection browser extension.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "webNavigation"
  ],

  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "PhishGuard Security Scanner",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dist/content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/warning/warning.html",
        "src/warning/warning.css",
        "public/icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
